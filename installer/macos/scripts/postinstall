#!/bin/bash
# livelooper installer: remove the download quarantine from the installed bundles,
# re-sign them ad hoc (so hosts load them without a Gatekeeper block), install the
# Gatekeeper fix script for later use and refresh the Audio Unit cache.
for b in "/Applications/livelooper.app" \
         "/Library/Audio/Plug-Ins/VST3/livelooper.vst3" \
         "/Library/Audio/Plug-Ins/Components/livelooper.component"; do
    if [ -e "$b" ]; then
        /usr/bin/xattr -dr com.apple.quarantine "$b" 2>/dev/null || true
        /usr/bin/codesign --force --deep --sign - "$b" 2>/dev/null || true
    fi
done
here="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$here/fix-gatekeeper.command" ]; then
    mkdir -p "/Library/Application Support/livelooper"
    cp "$here/fix-gatekeeper.command" "/Library/Application Support/livelooper/"
    chmod 755 "/Library/Application Support/livelooper/fix-gatekeeper.command"
fi
/usr/bin/killall -9 AudioComponentRegistrar 2>/dev/null || true
exit 0
